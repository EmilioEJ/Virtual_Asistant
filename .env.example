# Copia este archivo a .env en el servidor y completa los valores.
# El .env real NO se comitea (está en .gitignore).

# ============================================================
# CONFIGURACIÓN DEL PROVEEDOR DE IA
# Opciones: "gemini" | "siliconflow" | "groq" | "openwebui" | "nvidia"
# ============================================================
AI_PROVIDER=nvidia

# --- NVIDIA API ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenWebUI (Servidor local con Ollama) ---
OPENWEBUI_API_KEY=your_openwebui_key_here
OPENWEBUI_MODEL_NAME=qwen3:14b
OPENWEBUI_BASE_URL=http://tu_ip_aqui:3006/api

# --- Gemini (Google) ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# --- SiliconFlow ---
SILICONFLOW_API_KEY=your_siliconflow_key_here
SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-V3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# --- Groq (Para Speech-to-Text Whisper o Modelos Llama) ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- ElevenLabs (Síntesis de Voz TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_key_here
